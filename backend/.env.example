# ---- Django ----
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
# Comma separated hostnames. Use * for quick testing only.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- CORS ----
# Comma separated origins allowed to call this API (the deployed React URL).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Database (PostgreSQL) ----
# Option A: a single DATABASE_URL (this is what Render injects automatically).
# DATABASE_URL=postgres://user:password@host:5432/dbname
#
# Option B: individual vars (used when DATABASE_URL is not set).
DB_ENGINE=django.db.backends.postgresql
DB_NAME=gate_intake
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Zero-config escape hatch: set True to use a local SQLite file instead of Postgres.
# Note: pgcrypto is Postgres-only, so on SQLite the PII layer falls back to an
# equivalent in-process AES-256-GCM implementation. Use Postgres for production.
USE_SQLITE_FALLBACK=False

# ---- Column-level PII encryption ----
# BOTH are required in production and MUST differ from each other.
#   PII_ENCRYPTION_KEY  -> pgcrypto passphrase for candidate name/phone/email
#   PII_BLIND_INDEX_KEY -> separate pepper for the searchable HMAC blind index
#
# Losing PII_ENCRYPTION_KEY makes every stored name/phone/email unrecoverable.
# Changing PII_BLIND_INDEX_KEY breaks name search + duplicate detection for
# existing rows (re-index by re-saving each profile).
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PII_ENCRYPTION_KEY=replace-me-with-48-bytes-of-urlsafe-entropy-000000
PII_BLIND_INDEX_KEY=replace-me-with-a-DIFFERENT-48-byte-secret-00000000

# ---- Object storage (S3-compatible; the bucket MUST be private) ----
# Every document — Aadhaar, PAN, Safety cert, Medical, PVC, Resume — is stored
# here under an opaque key and read back only through presigned URLs.
#
#   Supabase Storage:  https://<project-ref>.supabase.co/storage/v1/s3
#                      S3_REGION must be the project's real region (e.g.
#                      ap-south-1) — Supabase rejects "auto".
#                      Create the S3 access key under
#                      Project Settings → Storage → S3 access keys.
#   Cloudflare R2:     https://<account_id>.r2.cloudflarestorage.com  (region "auto")
#   MinIO (local dev): http://127.0.0.1:9000
#
# Leave S3_ENDPOINT_URL empty to use the local signed-filesystem fallback —
# fine for `runserver` and the test suite, not for a deployment.
S3_ENDPOINT_URL=
S3_BUCKET=gate-intake-docs
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_KEY_PREFIX=gate-intake
# Presigned link lifetime, clamped to 60..3600 seconds.
PRESIGN_EXPIRY_SECONDS=900

# ---- Resume parsing ----
# claude  — Anthropic vision → schema-constrained JSON (best quality)
# gemini  — Google Gemini vision
# ocr     — OCR text + heuristics; no LLM key required (default)
# mock    — canned values, no network
RESUME_PARSER_PROVIDER=ocr
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
# GEMINI_API_KEY=your-google-ai-studio-key
# GEMINI_MODEL=gemini-2.0-flash

# Should a missing resume block deployment? Off by default: the resume pillar is
# always reported, but only counts against compliance when this is True.
REQUIRE_RESUME_FOR_COMPLIANCE=False

# ---- OCR (document field extraction in the intake workbench) ----
# Provider selects how uploaded scans are read into form fields:
#   ocrspace  (default) — free hosted OCR.space API; set OCRSPACE_API_KEY
#   tesseract           — local Tesseract binary (dev only; not on Render native)
#   mock                — canned sample values, no network (always works)
OCR_PROVIDER=ocrspace
# Free demo key "helloworld" works for a few docs. Get a free key (no card) at
# https://ocr.space/ocrapi for higher limits.
OCRSPACE_API_KEY=helloworld
